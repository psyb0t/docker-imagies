# syntax=docker/dockerfile:1.7
ARG ACCELERATOR=cpu
ARG IMAGIES_VARIANT=vision

FROM golang:1.26-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS worker
WORKDIR /src
COPY generation/worker/ ./
RUN --network=none CGO_ENABLED=0 go build -mod=vendor -trimpath -o /generation-worker ./cmd
RUN find vendor -type f \( -name 'LICENSE*' -o -name 'NOTICE*' -o -name 'COPYING*' \) \
    -exec cp --parents {} /usr/share/doc/ \;

FROM python:3.12-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64 AS build-cpu
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential git cmake ca-certificates && \
    rm -rf /var/lib/apt/lists/*

FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04@sha256:50efab398f76258daa91ceebb33b6467e40217c67ea44fb5a2cebc6be7d9cce3 AS build-cuda
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential git ccache cmake ca-certificates && \
    rm -rf /var/lib/apt/lists/*

FROM build-${ACCELERATOR} AS diffusion
ARG ACCELERATOR
ARG CUDA_ARCHITECTURES=all-major
ARG SDCPP_BUILD_JOBS=4
WORKDIR /sd.cpp
RUN git clone https://github.com/leejet/stable-diffusion.cpp . && \
    git checkout c97702e1057c2fe13a7074cd9069cb9dd6edc1bf && \
    git submodule update --init --recursive
RUN if [ "$ACCELERATOR" = cuda ]; then \
        cmake -S . -B build -DGGML_NATIVE=OFF -DSD_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES="$CUDA_ARCHITECTURES"; \
    else \
        cmake -S . -B build -DGGML_NATIVE=OFF; \
    fi && cmake --build build --config Release -j "$SDCPP_BUILD_JOBS"

FROM python:3.12-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64 AS runtime-cpu-editing
ENV PATH=/app/.venv/bin:$PATH EXTRA_ARGS="-t,-1"

FROM psyb0t/torchbase:py3.12-torch2.14-latest-cpu AS runtime-cpu-vision
ENV EXTRA_ARGS="-t,-1"

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04@sha256:8aef630a54bc5c5146ae5ce68e6af5caa3df0fb690bb91544175c91f307e4356 AS runtime-cuda-editing
ENV PATH=/app/.venv/bin:$PATH EXTRA_ARGS="--clip-on-cpu,--diffusion-fa"
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-venv && \
    rm -rf /var/lib/apt/lists/*

FROM psyb0t/torchbase:py3.12-torch2.14-latest-cu126 AS runtime-cuda-vision
ENV EXTRA_ARGS="--clip-on-cpu,--diffusion-fa"

FROM runtime-$ACCELERATOR-$IMAGIES_VARIANT
USER root
ARG ACCELERATOR
ARG IMAGIES_VARIANT
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    IMAGIES_GENERATION=1 MODEL_PREFIX=imagies- HTTP_SERVER_WRITETIMEOUT=15m
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgomp1 ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN if [ "$IMAGIES_VARIANT" = vision ]; then \
        uv export --locked --no-dev --extra vision --quiet --output-file /tmp/imagies-requirements.txt && \
        uv pip install --python "$VIRTUAL_ENV/bin/python" --require-hashes --no-deps \
            -r /tmp/imagies-requirements.txt && \
        uv pip check --python "$VIRTUAL_ENV/bin/python" && \
        rm /tmp/imagies-requirements.txt; \
    else \
        uv sync --locked --no-dev; \
    fi
COPY src ./src
COPY --from=worker /generation-worker /usr/local/bin/imagies-generation-worker
COPY --from=worker /usr/share/doc/vendor /usr/share/doc/imagies/go
COPY --from=diffusion /sd.cpp/build/bin/sd-server /sd-server
COPY --from=diffusion /sd.cpp/LICENSE /usr/share/doc/imagies/stable-diffusion.cpp/LICENSE
COPY --from=diffusion /sd.cpp/ggml/LICENSE /usr/share/doc/imagies/ggml/LICENSE
COPY --from=diffusion /sd.cpp/examples/server/frontend/LICENSE /usr/share/doc/imagies/frontend/LICENSE
COPY --from=diffusion /sd.cpp/thirdparty/LICENSE.darts_clone.txt /usr/share/doc/imagies/darts_clone/LICENSE
COPY --from=diffusion /sd.cpp/thirdparty/libwebm/LICENSE.TXT /usr/share/doc/imagies/libwebm/LICENSE
COPY --from=diffusion /sd.cpp/thirdparty/libwebp/COPYING /sd.cpp/thirdparty/libwebp/PATENTS /usr/share/doc/imagies/libwebp/
COPY LICENSE /usr/share/doc/imagies/LICENSE
COPY generation/models-cpu.json generation/models.json /etc/sdcpp/
RUN if [ "$ACCELERATOR" = cpu ]; then cp /etc/sdcpp/models-cpu.json /etc/sdcpp/models.json; fi && \
    mkdir /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 8000
VOLUME ["/data"]
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s CMD ["python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/healthz', timeout=2).close()"]
CMD ["uvicorn", "imagies.server:app", "--host", "0.0.0.0", "--port", "8000"]
