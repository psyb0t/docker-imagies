{
  "name": "@psyb0t/imagies",
  "version": "0.0.0",
  "mcpName": "io.github.psyb0t/imagies",
  "description": "Streamable HTTP MCP bridge for a self-hosted Imagies server.",
  "type": "module",
  "bin": {
    "imagies-mcp": "bin/cli.js"
  },
  "files": [
    "bin",
    "index.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "WTFPL",
  "author": "psyb0t",
  "homepage": "https://github.com/psyb0t/docker-imagies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psyb0t/docker-imagies.git"
  },
  "bugs": {
    "url": "https://github.com/psyb0t/docker-imagies/issues"
  },
  "keywords": [
    "imagies",
    "mcp",
    "openclaw",
    "image-processing",
    "image-generation"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mcp-remote": "0.1.38"
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    }
  }
}
