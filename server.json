{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.psyb0t/imagies",
  "title": "Imagies",
  "description": "Edit, analyze and generate still images with a self-hosted MCP server.",
  "version": "0.0.0",
  "repository": {
    "url": "https://github.com/psyb0t/docker-imagies",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "docker.io/psyb0t/imagies:latest",
      "runtimeHint": "docker",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8000/v1/mcp"
      }
    }
  ]
}
